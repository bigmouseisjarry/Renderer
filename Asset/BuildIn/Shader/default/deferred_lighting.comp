#version 460
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_samplerless_texture_functions : enable
#include "include/common.glsl"


layout(push_constant) uniform DeferredLightSetting {
    uint mode;
    uint directOnly;
    float maxRadius;
} SETTING;

// 0    Color
// 1    Normal
// 2    Roughness/Metallic
// 3    World pos
// 4    Shadow
// 5    Linear depth
// 6    Shadow cascade
// 7    Cluster light count
// 8    Cluster XY
// 9    Cluster Z
// 10   Indirect light
// 11   Indirect irradiance
// 12   Direct light

const vec4 CascadeColors[4] = {
	vec4(1.0f, 0.0f, 0.0f, 1.0f),
	vec4(0.0f, 1.0f, 0.0f, 1.0f),
	vec4(0.0f, 0.0f, 1.0f, 1.0f),
	vec4(1.0f, 1.0f, 0.0f, 1.0f)
};

#define THREAD_SIZE_X 16
#define THREAD_SIZE_Y 16
#define THREAD_SIZE_Z 1
layout (local_size_x = THREAD_SIZE_X, 
		local_size_y = THREAD_SIZE_Y, 
		local_size_z = THREAD_SIZE_Z) in;
void main()
{
    ivec2 pixel     = ivec2(gl_GlobalInvocationID.xy);
    vec2 uv         = ScreenPixToUV(pixel); 

    vec4 gbffer0 = texelFetch(G_BUFFER_DIFFUSE_TRANSPARENT, pixel, 0);
    vec4 gbffer1 = texelFetch(G_BUFFER_NORMAL_SPECF, pixel, 0);
    vec4 gbffer2 = texelFetch(G_BUFFER_EMISSION, pixel, 0);
    vec4 gbffer6 = texelFetch(G_BUFFER_SPECULAR_F0_ROUGHNESS, pixel, 0);
    vec3 diffuse    = gbffer0.xyz;                      //写入端已预乘(1-m)
    vec3 normal     = DecodeGBufferNormal(gbffer1.xyz);
    vec3 emission   = DecodeEmissionRGBM(gbffer2);
    float roughness = gbffer6.w;
    vec3 F0         = gbffer6.rgb;
    float specF     = gbffer1.a;                        

    vec4 gbffer5        = texelFetch(G_BUFFER_GEOMETRIC_NORMAL_AO, pixel, 0);
    vec3 gnormal        = DecodeGBufferNormal(gbffer5.xyz);   //几何法线：供后续RT偏移/AO方向gating
    float ao            = gbffer5.w;
    float transparent   = gbffer0.a;                    
    float ior           = texelFetch(G_BUFFER_IOR, pixel, 0).r * 2.0f + 1.0f;   //R8编码(η-1)/2的解码；薄透明pass写，透射落地后消费
    diffuse             *= (1.0f - transparent);

    vec4 worldPos   = DepthToWorld(uv);  // 从UV重建的世界坐标会有一些精度误差，不算大

    // 光照参数计算 //////////////////////////////////

	vec3 N          = normalize(normal);                        //法线
	vec3 V          = normalize((CAMERA.pos - worldPos).xyz);	//视线
    vec3 R          = normalize(reflect(-V, N));                //反射

    // 直接光照计算 //////////////////////////////////
    // 1+2
    vec3 directLightColor =
        DirectionalLighting(diffuse, roughness, F0, specF, worldPos, N, V) * DirectionalShadow(worldPos, pixel, SETTING.maxRadius) +
        PointLighting(diffuse, roughness, F0, specF, worldPos, N, V);

    // 间接光照计算 //////////////////////////////////
    // 3
    vec3 indirectLightColor = vec3(0.0f);
    if(SETTING.directOnly == 0)
    //if(SETTING.directOnly == 0 || roughness > 0.75f) // 给高粗糙度的提供DDGI的radiance做镜面反射
    {
        indirectLightColor = IndirectLighting(diffuse, roughness, F0, worldPos, N, V) * ao;    //AO只衰减间接（直接光已有阴影项）
    }

    // 输出 //////////////////////////////////
    // 1+2+3+5
    vec3 outColor           = directLightColor + indirectLightColor + emission;	

    int cascadeLevel        = CascadeLevel(worldPos);
    float directionalShadow = DirectionalShadow(worldPos, pixel, SETTING.maxRadius);

    ivec3 clusterGrid       = FetchLightClusterGrid(WorldToNDC(worldPos).xyz);
    uvec2 clusterIndex      = FetchLightClusterIndex(clusterGrid);  //读取对应cluster的索引信息 

    DirectionalLight probeLight  = LIGHTS.directionalLights[0];
    vec3 probeL                  = -normalize(probeLight.dir);
    vec3 probeRadiance           = probeLight.color * probeLight.intencity;
    BRDFData probeBRDF           = ResolveBRDF(diffuse, roughness, F0, specF, N, V, probeL);
    float probeNoL               = saturate(dot(N, probeL));

    vec4 finalColor = vec4(0.0f);
    if(SETTING.mode == 0)   finalColor = vec4(outColor, 1.0f);
    if(SETTING.mode == 1)   finalColor = vec4(vec3(N * 0.5f + 0.5f), 1.0f);
    if(SETTING.mode == 2)   finalColor = vec4(roughness, RGBtoLuminance(F0), 0.0f, 1.0f);
    if(SETTING.mode == 3)   finalColor = worldPos;
    if(SETTING.mode == 4)   finalColor = vec4(vec3(directionalShadow), 1.0f);
    if(SETTING.mode == 5)   finalColor = vec4(vec3(Linear01Depth(FetchDepth(uv), CAMERA.near, CAMERA.far)), 1.0f);
    if(SETTING.mode == 6)   finalColor = CascadeColors[cascadeLevel];
    if(SETTING.mode == 7)   finalColor = vec4(vec3(clusterIndex.y / float(MAX_LIGHTS_PER_CLUSTER)), 1.0f);
    if(SETTING.mode == 8)   finalColor = vec4(clusterGrid.xy / vec2(LIGHT_CLUSTER_WIDTH, LIGHT_CLUSTER_HEIGHT), 0.0f, 1.0f);
    if(SETTING.mode == 9)   finalColor = vec4(vec3(clusterGrid.z / float(LIGHT_CLUSTER_DEPTH)), 1.0f);
    if(SETTING.mode == 10)  finalColor = vec4(indirectLightColor, 1.0f);
    if(SETTING.mode == 11)  finalColor = vec4(IndirectIrradiance(worldPos, N, V), 1.0f);
    if(SETTING.mode == 12)  finalColor = vec4(vec3(ao), 1.0f);
    if(SETTING.mode == 13)  finalColor = vec4(gnormal * 0.5f + 0.5f, 1.0f);
    if(SETTING.mode == 14)  finalColor = vec4(F0, 1.0f);
    if(SETTING.mode == 15)  finalColor = vec4(vec3(transparent), 1.0f);
    if(SETTING.mode == 16)  finalColor = vec4(emission, 1.0f);
    if(SETTING.mode == 17)  finalColor = vec4(directLightColor, 1.0f);
    if(SETTING.mode == 18)  finalColor = vec4(probeBRDF.specular * probeRadiance * probeNoL, 1.0f);
    if(SETTING.mode == 19)  finalColor = vec4(probeBRDF.diffuse * probeRadiance * probeNoL, 1.0f);

    if(GLOBAL_SETTING.clusterInspectMode != 0) finalColor = vec4(diffuse.xyz, 1.0f);

    imageStore(FINAL_COLOR, pixel, finalColor);
}




// 直接光漫反射 = 1
// 直接光镜面反射 = 2
// 间接光漫反射 = 3
// 间接光镜面反射 = 4
// 自发光 = 5