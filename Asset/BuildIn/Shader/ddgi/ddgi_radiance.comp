#version 460
#extension GL_ARB_separate_shader_objects : enable
#extension GL_GOOGLE_include_directive : enable

#include "include/common.glsl"

layout(push_constant) uniform DDGIComputeSetting {
	int volumeLightID;
	float _padding[3];
} SETTING;

#define THREAD_SIZE_X 32
#define THREAD_SIZE_Y 32
#define THREAD_SIZE_Z 1
layout (local_size_x = THREAD_SIZE_X, 
        local_size_y = THREAD_SIZE_Y, 
        local_size_z = THREAD_SIZE_Z) in;
void main()
{
    // 刀6f已毕（短路写零→绿10000帧）：毒在U0计算内容。现6g-A三件依赖二分
    // 第一轮 计算辐射率
    VolumeLight volumeLight = LIGHTS.volumeLights[SETTING.volumeLightID];
    
    ivec2 pixel       = ivec2(gl_GlobalInvocationID.xy);
    int   probeIndex  = pixel.y;
    int   rayIndex   = pixel.x;

    ivec3 probeCoord  = FetchProbeCoord(volumeLight.setting, probeIndex);
    vec3  origin      = FetchProbeWorldPos(volumeLight.setting, probeCoord);

    vec4 dirDist        = imageLoad(TRACE_DIRECTION_DIST,      pixel);
    vec4 normal         = imageLoad(TRACE_NORMAL_ROUGHNESS,    pixel);
    vec4 albedoMetallic = imageLoad(TRACE_ALBEDO_METALLIC,     pixel);
    vec4 emission       = imageLoad(TRACE_EMISSION,            pixel);

    vec3 direction  = dirDist.xyz;
    float dist      = dirDist.w;
    float roughness = normal.w;     //粗糙度
    vec3 albedo     = albedoMetallic.xyz;    
    float metallic  = albedoMetallic.w;    //金属度

    vec3 radiance   = vec3(0.0f);    //漫反射辐射率

    // 光照计算
    if(dist < MAX_RAY_TRACING_DISTANCE && length(normal.xyz) > 0.01)
    {
        //光照计算相关向量////////////////////////////////////////////////////////////////////////////////////////////////////////

        vec4 worldPos = vec4(origin + direction * dist, 1.0f);      //相对坐标到绝对世界坐标

        vec3 N = normalize(normal.xyz);	                //法线
        vec3 V = normalize(-direction);	                //视线，此处的视线原点是探针位置
        vec3 R = normalize(reflect(-V, N));             //反射
        float NoV = dot(N, V); 

        // 直接光照计算，仅漫反射 //////////////////////////////////

        // 刀6h（2026-10-20终修复）：DDGI点光改全表遍历，不走屏幕空间cluster。定案依据：
        // ①6g-D短路cluster查询→10000帧零噪零崩（6f/6g-A梯度夹逼）；②git考古=同一计算在
        // 7de3be2（cluster住set0常驻集，视图结构性有效，视锥外越界imageLoad返0=count0天然无害）
        // 长跑无事；③刀5把cluster搬进set2池化集后视图靠逐帧轮转（GPU-AV实锤"never been updated"
        // 悬空），DDGI是全引擎唯一喂世界空间坐标进此链的调用者→UB源。cluster剔除为屏幕空间
        // 设计，世界空间查询属错配；光源数小全表遍历代价可忽略（lightID从1起，0为哨兵无效ID）
        vec3 pointDiffuse = vec3(0.0f);
        for(uint lightID = 1; lightID <= LIGHTS.lightSetting.pointLightCnt; lightID++)
            pointDiffuse += PointDiffuseLighting(albedo, roughness, metallic, worldPos, N, V, lightID) *
                            PointShadow(lightID, worldPos);

        vec3 directLightColor =
            DirectionalDiffuseLighting(albedo, roughness, metallic, worldPos, N, V) * DirectionalShadow(worldPos, pixel,2.0) +
            pointDiffuse;

        // 间接光照计算 //////////////////////////////////

        vec3 indirectLightColor = volumeLight.setting.infiniteBounce ?
            IndirectLighting(albedo, roughness, metallic, worldPos, N, V) :
            vec3(0.0f);

        //合并////////////////////////////////////////////////////////////////////////////////////////////////////////
        radiance = directLightColor + indirectLightColor;
        radiance += emission.xyz;

        if(NoV <= 0.0f)
            radiance.xyz = vec3(0.0f);    // trace到背面了
    }
    else if(dist == MAX_RAY_TRACING_DISTANCE)
    {
        radiance = albedo;  //天光
    }

    // 1+3+5
    imageStore(DDGI_RADIANCE, pixel, vec4(radiance, 0.0f));
}



