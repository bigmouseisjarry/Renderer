#include "common.glsl"

layout(set = 1, binding = 3)                uniform texture2D NRD_OUT_DIFFUSE;
layout(set = 1, binding = 4)                uniform texture2D NRD_OUT_SPECULAR;
layout(set = 1, binding = 5, rgba16f)       uniform image2D OUT;	

#define THREAD_SIZE_X 16
#define THREAD_SIZE_Y 16
#define THREAD_SIZE_Z 1
layout (local_size_x = THREAD_SIZE_X, 
		local_size_y = THREAD_SIZE_Y, 
		local_size_z = THREAD_SIZE_Z) in;
