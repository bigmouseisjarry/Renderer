#version 460
#extension GL_ARB_separate_shader_objects : enable
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_samplerless_texture_functions : enable

#include "include/common.glsl"

layout(push_constant) uniform NRDSetting
{
    uint isBaseColorMetalnessAvailable;
    uint enableAntiFirefly;
    uint demodulate;
    uint denoisedOnly;
    uint specularOnly;
    uint restirEnabled;
    float splitScreen;
    float motionVectorScaleX;
    float motionVectorScaleY;
    float motionVectorScaleZ;
    uint side;               // view_z用：0=双边打包(legacy), 1=仅specular, 2=仅diffuse
} SETTING;

	
////////
#define THREAD_SIZE_X 16
#define THREAD_SIZE_Y 16
#define THREAD_SIZE_Z 1
layout (local_size_x = THREAD_SIZE_X,
		local_size_y = THREAD_SIZE_Y,
		local_size_z = THREAD_SIZE_Z) in;
void main()
{
    ivec2 pixel     = ivec2(gl_GlobalInvocationID.xy);
    vec2 uv         = ScreenPixToUV(pixel);
    float depth     = texelFetch(DEPTH[0], pixel, 0).r;
    float viewZ     = ScreenToView(uv, depth).z;
    if(depth == 1.0f)
        viewZ = sign(viewZ) * 1e5;

    vec4 gbffer1    = texelFetch(G_BUFFER_NORMAL_SPECF, pixel,0);
    vec4 gbfferF0   = texelFetch(G_BUFFER_SPECULAR_F0_ROUGHNESS, pixel,0);
    vec3 normal     = DecodeGBufferNormal(gbffer1.xyz);
    float roughness = gbfferF0.w;
    vec4 normalRoughness = NRD_FrontEnd_PackNormalAndRoughness(normal, roughness, 0);

    vec3 demod = vec3(1.0f);
    if(SETTING.demodulate > 0)
    {
        vec3 diffuse       = texelFetch(G_BUFFER_DIFFUSE_TRANSPARENT, pixel,0).xyz;
        float luminance    = RGBtoLuminance(diffuse);
        if(luminance > 1e-3)
            demod = diffuse;
    }

    if(SETTING.side != 1)     // diffuse侧（0/2）：REBLUR打包
    {
        vec4 diffuseHitDist = imageLoad(DI_DIFFUSE_COLOR, pixel);
        if(SETTING.demodulate > 0 && RGBtoLuminance(demod) > 1e-3)
            diffuseHitDist.xyz = diffuseHitDist.xyz / demod;
        vec4 hitDistParams = vec4(3.0f, 0.1f, 20.0f, -25.0f);
        float normHitDist = REBLUR_FrontEnd_GetNormHitDist(diffuseHitDist.w, viewZ, hitDistParams, roughness);
        vec4 diffuseNormHitDist = REBLUR_FrontEnd_PackRadianceAndNormHitDist(diffuseHitDist.xyz, normHitDist, true);
        imageStore(DI_DIFFUSE_COLOR, pixel, diffuseNormHitDist);
    }
    if(SETTING.side != 2)     // specular侧（0/1）：RELAX打包
    {
        vec4 specularHitDist = imageLoad(DI_SPECULAR_COLOR, pixel);
        if(SETTING.demodulate > 0 && RGBtoLuminance(demod) > 1e-3)
            specularHitDist.xyz = specularHitDist.xyz / demod;
        vec4 specularNormHitDist = RELAX_FrontEnd_PackRadianceAndHitDist(specularHitDist.xyz, specularHitDist.w, true);
        imageStore(DI_SPECULAR_COLOR, pixel, specularNormHitDist);
    }

    imageStore(NRD_VIEW_Z, pixel, vec4(viewZ, 0, 0, 0)); //view space 负向向前
    imageStore(NRD_NORMAL, pixel, normalRoughness);
}