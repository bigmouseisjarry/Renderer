#version 460
#extension GL_GOOGLE_include_directive : enable

#include "include/common.glsl"

#define THREAD_SIZE_X 256
#define THREAD_SIZE_Y 1
#define THREAD_SIZE_Z 1
layout (local_size_x = THREAD_SIZE_X, 
		local_size_y = THREAD_SIZE_Y, 
		local_size_z = THREAD_SIZE_Z) in;
void main() 
{
	uint gID = gl_GlobalInvocationID.x;

    // 在这里添加组件的Gizmo
    if(gID < LIGHTS.lightSetting.pointLightCnt)
    {
		LightStructGPU pointLight = LIGHTS.slot[gID + LIGHTS.lightSetting.directionalLightCnt];   // 


        AddGizmoBillboard(pointLight.position_range.xyz, vec2(0.5f), GLOBAL_SETTING.icons.pointLightIcon, vec4(pointLight.radiance_type.rgb, 1.0f));
        //AddGizmoSphere(pointLight.position_range.xyz, pointLight.position_range.w, vec4(pointLight.radiance_type.rgb, 1.0f));
    }

    if(gID == 0 && LIGHTS.lightSetting.directionalLightCnt != 0)    // 目前只支持一个
    {
        LightStructGPU dirLight = LIGHTS.slot[0];
        
        // 方向光无位置字段，图标摆相机+朝太阳100m（原方案定案）
        AddGizmoBillboard(CAMERA.pos.xyz + dirLight.mainDirection_id.xyz * 100.0f, vec2(0.5f), GLOBAL_SETTING.icons.directionalLightIcon, vec4(dirLight.radiance_type.rgb, 1.0f));
    }
}



