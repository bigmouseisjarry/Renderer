#version 460
#extension GL_EXT_ray_tracing : enable
#extension GL_ARB_separate_shader_objects : enable
#extension GL_GOOGLE_include_directive : enable


#include "include/common.glsl"


#define THREAD_SIZE_X 16
#define THREAD_SIZE_Y 16
#define THREAD_SIZE_Z 1
layout (local_size_x = THREAD_SIZE_X, 
		local_size_y = THREAD_SIZE_Y, 
		local_size_z = THREAD_SIZE_Z) in;
void main() 
{
    ivec2 pixel     = ivec2(gl_GlobalInvocationID.xy);
    vec2 uv         = ScreenPixToUV(pixel); 

    vec4 gbffer0    = imageLoad(RESTIR_DI_GBUFFER_DIFFUSE, pixel);
    vec4 gbffer1    = imageLoad(RESTIR_DI_GBUFFER_NORMAL, pixel);
    vec4 gbffer2    = imageLoad(RESTIR_DI_GBUFFER_EMISSION, pixel);
    vec4 gbffer6    = imageLoad(RESTIR_DI_GBUFFER_SPECF0, pixel);
    vec3 diffuse    = gbffer0.xyz;
    float specF     = gbffer1.a;    // 虹彩标志：F直用烘焙F0跳过Schlick
    vec3 normal     = DecodeGBufferNormal(gbffer1.xyz);
    vec3 emission   = DecodeEmissionRGBM(gbffer2);
    float roughness = gbffer6.w;
    vec3 F0         = gbffer6.rgb;
    vec4 worldPos   = DepthToWorld(uv);
	float depth 	= FetchDepthTex(pixel);

	// 点光源采样，创建新Reservoir //////////////////////////////////

	uint reservoirIndex = ReservoirIndex(pixel);
	DIReservoir res = NewDIReservoir();
	Rand rand = SeedRand(GLOBAL_SETTING.totalTicks, (pixel.y + WINDOW_HEIGHT) * GLOBAL_SETTING.totalTicks + (pixel.x + WINDOW_WIDTH));

	if(depth == 1.0f)	// 无效的G-Buffer信息
	{
		RESTIR_DI_RESERVOIRS[reservoirIndex] = res;
		return;
	}

	for (int i = 0; i < RESTIR_DI_SETTING.initialSampleCount; i++) 
	{	
		uint lightID = LIGHTS.lightSetting.pointLightIDs[uint(round(RandFloat(rand) * (LIGHTS.lightSetting.pointLightCnt - 1)))];	// 抽样选取点光源及其选择概率，直接用均匀分布了
		float lightSampleProb = (1.0f / LIGHTS.lightSetting.pointLightCnt);	

		float pHat = EvaluatePHat(
			lightID, worldPos.xyz, normal,
			diffuse, roughness, F0, specF);

		AddSampleToDIReservoir(res, lightID, pHat, lightSampleProb, rand);
	}
	
	// 时域复用Reservoir //////////////////////////////////

	if (RESTIR_DI_SETTING.temporalReuse != 0) 
	{
		vec4 reprojection   = texelFetch(REPROJECTION_RESULT, pixel, 0);
		ivec2 prevPixel     = ivec2(reprojection.zw);
		bool valid          = prevPixel.x > 0.0f ? true : false;	

		if(valid)
		{
			DIReservoir prevRes = RESTIR_DI_PREV_RESERVOIRS[ReservoirIndex(prevPixel)];	
			prevRes.numStreamSamples = min(prevRes.numStreamSamples, RESTIR_DI_SETTING.temporalSampleCountMultiplier * res.numStreamSamples);	// 需要设置一个累计采样数的上限
			
			float newPHat = EvaluatePHat(								// 时域复用下的可见性测试使用的是阴影贴图
					prevRes.sampl.lightID, worldPos.xyz, normal,		// 空域用的光追
					diffuse, roughness, F0, specF);
			CombineDIReservoirs(res, prevRes, newPHat, rand);		
		}
	}

	if (RESTIR_DI_SETTING.visibilityReuse != 0) 
	{
		bool shadowed = RayQueryVisibility(worldPos.xyz, LIGHTS.pointLights[res.sampl.lightID].pos, GLOBAL_SETTING.rayTracingOffset);
		if (shadowed) 
		{
			CleanDIReservoir(res);		
		}
	}

	RESTIR_DI_RESERVOIRS[reservoirIndex] = res;
}
